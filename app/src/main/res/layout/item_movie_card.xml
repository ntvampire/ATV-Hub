<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/poster_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/tv_card_spacing"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/card_poster_container"
        android:layout_width="@dimen/poster_width"
        android:layout_height="@dimen/poster_height"
        android:background="@drawable/selector_card_border"
        android:duplicateParentState="true"
        android:padding="2dp">

        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Плашка качества (1080p, 4K, WEB-DL) -->
        <TextView
            android:id="@+id/tv_quality_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/badge_background"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:textColor="@color/badge_text"
            android:textSize="@dimen/text_size_badge"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Рейтинг -->
        <TextView
            android:id="@+id/tv_rating_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:background="@drawable/badge_background"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:textColor="@color/accent_white"
            android:textSize="@dimen/text_size_badge"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Прогресс досмотра -->
        <ProgressBar
            android:id="@+id/pb_watch_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressTint="@color/accent_white"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_body" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_badge" />

</LinearLayout>
