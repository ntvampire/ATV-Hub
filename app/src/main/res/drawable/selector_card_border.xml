<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg_focused" />
            <stroke android:width="@dimen/focus_stroke_width" android:color="@color/border_focused" />
            <corners android:radius="@dimen/poster_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="1dp" android:color="@color/border_normal" />
            <corners android:radius="@dimen/poster_radius" />
        </shape>
    </item>
</selector>
